@model IReadOnlyList<Calculator.Data.DataInputVariant>
@{ ViewData["Title"] = "Калькулятор"; }
<h1>Калькулятор</h1>
<form asp-action="Calculate" method="post">
    <input type="number" step="any" name="num1" placeholder="Первое число" required />
    <select name="operation">
        <option value="Add">+</option><option value="Subtract">−</option>
        <option value="Multiply">×</option><option value="Divide">÷</option>
    </select>
    <input type="number" step="any" name="num2" placeholder="Второе число" required />
    <button type="submit">Вычислить</button>
</form>
<p>Результат появится после обработки Kafka. Обновите страницу.</p>
<table>
    <thead><tr><th>ID</th><th>Первое число</th><th>Второе число</th><th>Операция</th><th>Результат</th></tr></thead>
    <tbody>
    @foreach (var row in Model)
    {
        <tr><td>@row.ID_DataInputVariant</td><td>@row.Operand_1</td><td>@row.Operand_2</td><td>@row.Type_operation</td><td>@row.Result</td></tr>
    }
    </tbody>
</table>
