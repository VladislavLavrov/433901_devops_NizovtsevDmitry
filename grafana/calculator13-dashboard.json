{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Источник общего Prometheus на порту 9198",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "nizovtsev13-calculator",
  "title": "Калькулятор Низовцев 13",
  "tags": [
    "calculator",
    "nizovtsev13"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Среднее время выполнения",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg_over_time(http_server_request_duration_seconds_sum{instance=\"93.88.178.186:5013\",aspnetcore_request_is_unhandled!=\"true\",http_route!=\"/healthz\",http_route!=\"/metrics\",http_route!=\"\"}[1h]) / avg_over_time(http_server_request_duration_seconds_count{instance=\"93.88.178.186:5013\",aspnetcore_request_is_unhandled!=\"true\",http_route!=\"/healthz\",http_route!=\"/metrics\",http_route!=\"\"}[1h])",
          "legendFormat": "{{http_route}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Количество запросов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{instance=\"93.88.178.186:5013\",aspnetcore_request_is_unhandled!=\"true\",http_route!=\"/healthz\",http_route!=\"/metrics\",http_route!=\"\"}[1h]) * 3600)",
          "legendFormat": "{{http_route}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ошибки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (error_type) (increase(http_server_request_duration_seconds_count{instance=\"93.88.178.186:5013\",http_response_status_code=\"500\"}[10m]))",
          "legendFormat": "{{error_type}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    }
  ]
}
